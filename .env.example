APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Drive — service account auth (never expires, correct for server deployments)
# Share the target folder with the service account email found in the JSON file (client_email)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=storage/app/csms-489705-0132f004c56b.json
GOOGLE_DRIVE_FOLDER=

# ─── CAIS / LMS Integration ───────────────────────────────────────────────────
CAIS_API_KEY=
CAIS_API_TIMEOUT=10

CAIS_COLLEGES_API_ENDPOINT=https://cais.clsu.edu.ph/api/colleges
CAIS_DEPARTMENTS_API_ENDPOINT=https://cais.clsu.edu.ph/api/departments
CAIS_COURSES_API_ENDPOINT=https://cais.clsu.edu.ph/api/courses
CAIS_SEMESTERS_API_ENDPOINT=https://cais.clsu.edu.ph/api/semesters
CAIS_SCHEDULES_API_ENDPOINT=https://cais.clsu.edu.ph/api/schedules
CAIS_TEACHING_LOADS_API_ENDPOINT=https://cais.clsu.edu.ph/api/teaching-loads
CAIS_USERS_API_ENDPOINT=https://cais.clsu.edu.ph/api/users
CAIS_VERIFY_USER_API_ENDPOINT=https://cais.clsu.edu.ph/api/verify-user
CAIS_ENROLLMENTS_API_ENDPOINT=https://cais.clsu.edu.ph/api/enrollments
CAIS_REGISTRATIONS_API_ENDPOINT=https://cais.clsu.edu.ph/api/registrations

# Cache TTLs in seconds (optional — defaults defined in config/cais.php)
# CAIS_CACHE_COLLEGES=86400
# CAIS_CACHE_DEPARTMENTS=86400
# CAIS_CACHE_USER_PROFILE=3600
# CAIS_CACHE_USER_LIST=1800
# CAIS_CACHE_SEMESTERS=21600
# CAIS_CACHE_ACTIVE_SEMESTER=1800
# CAIS_CACHE_TEACHING_LOADS=900
# CAIS_CACHE_SCHEDULE=900
